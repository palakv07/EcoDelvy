# ==========================================
# EcoDelvy Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (NEVER COMMIT)
# ------------------------------------------
.env
.env.*
.env*.local
!.env.example
**/config/passwords.yaml
**/firebase_service_account_key.json
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pyvenv.cfg
pip-selfcheck.json
*.egg-info/
.installed.cfg
*.egg
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
.pytest_cache/
coverage/
*.cover
.coverage
.coverage.*
nosetests.xml
coverage.xml

# ------------------------------------------
# Serverpod Backend & Cloud
# ------------------------------------------
# Embedded PostgreSQL data & runtime artifacts
.serverpod/
**/.serverpod/

# Ephemeral test SQLite databases
**/sp_*.db*

# Serverpod Cloud CLI artifacts
**/.scloud/

# Compiled Flutter Web app served by Serverpod
eco_delvy_server/web/app/
**/web/app/

# ------------------------------------------
# Dart & Flutter
# ------------------------------------------
.dart_tool/
**/.dart_tool/
.packages
**/.packages
pubspec_overrides.yaml
build/
**/build/
.pub/
.pub-cache/
**/.pub/
**/.pub-cache/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Symbolization & Obfuscation
app.*.symbols
app.*.map.json

# Flutter platform ephemerals
**/android/local.properties
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/

# Ensure Dart and Python source libraries are never ignored
!**/lib/
!**/lib/**

# ------------------------------------------
# Database & Caches
# ------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
distance_cache.db

# ------------------------------------------
# Solver Logs & Outputs
# ------------------------------------------
*.log
logs/
*.ilp
*.lp
*.mps
*.sol
gurobi.log
results/
results/*.json

# ------------------------------------------
# OS & Editor Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*.swo
*~
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.vscode/
**/.vscode/
*.code-workspace
.ipynb_checkpoints
