# EcoDelvy
# Copy this file to .env and customize as needed

# API Settings
# Application Settings
APP_NAME="Fleet Route Optimizer API"
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local demo account. Change the password and generate a random secret before deployment.
AUTH_EMAIL=demo@fleet.local
AUTH_PASSWORD=FleetDemo!2026
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=
AUTH_ROLE=admin
AUTH_TOKEN_TTL_MINUTES=60
AUTH_COOKIE_SECURE=false

# Solver Settings
DEFAULT_TIME_LIMIT=60
DEFAULT_SOLVER=ortools
ORTOOLS_VEHICLE_PENALTY=100000.0
GUROBI_VEHICLE_PENALTY=1000.0
DEFAULT_DISTANCE_WEIGHT=1.0
DEFAULT_MIP_GAP=0.01

# Distance Cache Settings
DISTANCE_CACHE_DB=distance_cache.db
OSRM_BASE_URL=http://router.project-osrm.org

# Logging Settings
LOG_LEVEL=INFO

# File Paths
INPUTS_DIR=inputs
RESULTS_DIR=results

# Serverpod development database (used by eco_delvy_server/docker-compose.yaml)
# Replace both placeholders with local-only values and keep .env out of Git.
SERVERPOD_DB_PASSWORD=replace-with-a-local-database-password
SERVERPOD_TEST_DB_PASSWORD=replace-with-a-separate-test-password

# Private optimization worker. The worker URL must point to the Serverpod
# web-server origin (port 8082 locally), not the API port (8080).
SERVERPOD_WORKER_API_URL=http://localhost:8082
OPTIMIZATION_WORKER_TOKEN=replace-with-a-long-random-secret
WORKER_POLL_INTERVAL_SECONDS=2
# Set the exact same secret as optimizationWorkerToken in
# eco_delvy_server/config/passwords.yaml or through
# SERVERPOD_PASSWORD_optimizationWorkerToken in Serverpod deployments.

# The worker keeps the existing SQLite distance cache in its persistent volume.
# Set GRB_LICENSE_FILE only when using a licensed Gurobi deployment.
# GRB_LICENSE_FILE=/run/secrets/gurobi.lic
